// Prisma Schema for Digital HR by Jana Post
// Production-Ready Enterprise Database Schema

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Department {
  id                   String     @id @default(uuid())
  name                 String
  code                 String     @unique
  description          String?
  managerId            String?
  managerName          String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  employees            Employee[]

  @@map("departments")
}

model Employee {
  id                   String                   @id @default(uuid())
  employeeId           String                   @unique
  firstName            String
  lastName             String
  email                String                   @unique
  passwordHash         String
  role                 String                   @default("EMPLOYEE") // 'ADMIN' | 'HR_MANAGER' | 'DEPARTMENT_HEAD' | 'EMPLOYEE'
  status               String                   @default("ACTIVE")   // 'ACTIVE' | 'INACTIVE'
  jobTitle             String
  departmentId         String?
  departmentName       String?
  department           Department?              @relation(fields: [departmentId], references: [id])
  managerId            String?
  managerName          String?
  startDate            String
  phone                String?
  avatarUrl            String?
  address              String?
  emergencyContact     String?
  salary               Float?
  iin                  String?
  contractNumber       String?
  enbekStatus          String?                  @default("PENDING")
  enbekContractId      String?
  enbekSyncDate        String?
  vacationDaysTotal    Int                      @default(24)
  vacationDaysUsed     Int                      @default(0)
  kpiJson              String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  attendanceRecords    AttendanceRecord[]
  leaveRequests        LeaveRequest[]
  salaryAdvances       SalaryAdvanceRequest[]
  certificateRequests  CertificateRequest[]
  assignedTasks        TaskItem[]               @relation("TaskAssignee")
  createdTasks         TaskItem[]               @relation("TaskCreator")
  notifications        AppNotification[]
  courseProgress       EmployeeCourseProgress[]

  @@map("employees")
}

model AttendanceRecord {
  id              String    @id @default(uuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeName    String
  departmentName  String?
  workDate        String    // YYYY-MM-DD
  clockIn         String?   // ISO string
  clockOut        String?   // ISO string
  durationMinutes Int?
  status          String    @default("PRESENT") // 'PRESENT' | 'LATE' | 'HALF_DAY' | 'ABSENT'
  notes           String?
  createdAt       DateTime  @default(now())

  @@unique([employeeId, workDate])
  @@map("attendance_records")
}

model LeaveRequest {
  id              String    @id @default(uuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeName    String
  departmentName  String?
  leaveType       String    @default("ANNUAL") // 'ANNUAL' | 'SICK' | 'UNPAID' | 'MATERNITY' | 'STUDY'
  startDate       String    // YYYY-MM-DD
  endDate         String    // YYYY-MM-DD
  daysCount       Int
  reason          String
  status          String    @default("PENDING") // 'PENDING' | 'APPROVED' | 'REJECTED' | 'CANCELLED'
  submittedAt     String
  attachmentUrl   String?
  attachmentName  String?
  reviewerId      String?
  reviewerName    String?
  reviewComment   String?
  reviewedAt      String?
  createdAt       DateTime  @default(now())

  @@map("leave_requests")
}

model SalaryAdvanceRequest {
  id              String    @id @default(uuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeName    String
  departmentName  String?
  amount          Float
  payoutDate      String    // e.g. 15th of the month
  reason          String
  status          String    @default("PENDING") // 'PENDING' | 'APPROVED' | 'REJECTED'
  submittedAt     String
  reviewerId      String?
  reviewerName    String?
  reviewComment   String?
  reviewedAt      String?
  createdAt       DateTime  @default(now())

  @@map("salary_advance_requests")
}

model CertificateRequest {
  id              String    @id @default(uuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeName    String
  departmentName  String?
  certificateType String    // 'WORK_CONFIRMATION' | 'INCOME_CONFIRMATION_6M' | 'INCOME_CONFIRMATION_12M' | 'FORM_T2'
  purpose         String    // 'Банк / Ипотека', 'Посольство / Виза', 'По месту требования'
  language        String    @default("ru") // 'ru' | 'kz'
  status          String    @default("PENDING") // 'PENDING' | 'READY' | 'REJECTED'
  submittedAt     String
  completedAt     String?
  documentUrl     String?
  notes           String?
  createdAt       DateTime  @default(now())

  @@map("certificate_requests")
}

model TaskItem {
  id                 String    @id @default(uuid())
  title              String
  description        String?
  category           String?   @default("ONBOARDING") // 'ONBOARDING' | 'OFFBOARDING' | 'COMPLIANCE'
  targetEmployeeName String?
  status             String    @default("TODO")     // 'TODO' | 'IN_PROGRESS' | 'DONE' | 'CANCELLED'
  priority           String    @default("MEDIUM")   // 'LOW' | 'MEDIUM' | 'HIGH' | 'URGENT'
  assignedToId   String
  assignee       Employee  @relation("TaskAssignee", fields: [assignedToId], references: [id])
  assignedToName String
  createdById    String
  creator        Employee  @relation("TaskCreator", fields: [createdById], references: [id])
  createdByName  String
  dueDate        String
  createdAt      String
  completedAt    String?

  @@map("tasks")
}

model AppNotification {
  id        String    @id @default(uuid())
  userId    String?
  user      Employee? @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String    @default("SYSTEM") // 'LEAVE' | 'TASK' | 'ATTENDANCE' | 'ACADEMY' | 'SYSTEM'
  isRead    Boolean   @default(false)
  createdAt String
  link      String?

  @@map("notifications")
}

model Course {
  id               String                   @id
  title            String
  category         String
  description      String
  estimatedMinutes Int
  lessonsCount     Int
  isMandatory      Boolean                  @default(false)
  badgeName        String
  lessonsJson      String                   // Stored JSON of lessons
  quizJson         String                   // Stored JSON of quiz questions
  createdAt        DateTime                 @default(now())

  progressRecords  EmployeeCourseProgress[]

  @@map("courses")
}

model EmployeeCourseProgress {
  id              String    @id @default(uuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progressPercent Int       @default(0)
  isCompleted     Boolean   @default(false)
  score           Int?
  completedAt     String?
  updatedAt       DateTime  @updatedAt

  @@unique([employeeId, courseId])
  @@map("employee_course_progress")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String?
  userRole   String?
  action     String
  resource   String
  ipAddress  String?
  status     String   @default("SUCCESS") // 'SUCCESS' | 'FAILURE'
  details    String?  // JSON string
  timestamp  DateTime @default(now())

  @@map("audit_logs")
}
