# Digital HR by Jana Post - Frontend & Backend Environment Variables

# Backend API base URL (Vite proxy forwards /api to http://localhost:3000)
VITE_API_BASE_URL=/api/v1

# Mode Switch:
# true  = Standalone Demo Mode backed by localStorage
# false = Live API Mode connected to the persistent Express backend
VITE_ENABLE_MOCK=false

# Database Connection (Prisma SQLite by default, easily switchable to PostgreSQL)
DATABASE_URL="file:./dev.db"

# AI HR Assistant Configuration (Free Tier APIs)
# OpenRouter (NVIDIA Nemotron 3.5 Super VL, Gemini 2.0 Flash, Llama 3.3 70B)
OPENROUTER_API_KEY=""
VITE_OPENROUTER_API_KEY=""
# Groq Cloud API (Free tier models: llama-3.3-70b-versatile, llama-3.1-8b-instant)
GROQ_API_KEY=""
# Google Gemini Direct API
GEMINI_API_KEY=""
