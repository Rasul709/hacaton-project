# Digital HR by Jana Post - Frontend Environment Variables

# Backend API base URL
VITE_API_BASE_URL=http://localhost:3000/api/v1

# Hackathon Demo Mode
# Set to 'true' to use the in-memory mock service when the Node.js backend is offline
# Set to 'false' to communicate with the real backend REST API
VITE_ENABLE_MOCK=true
